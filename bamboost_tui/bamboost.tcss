$background-cp: transparent;

* {
    scrollbar-background: $background;
    scrollbar-color: $surface;
    scrollbar-color-active: $foreground;
    scrollbar-color-hover: $panel;
}

# ---------------------------------------------
# TOAST
# ---------------------------------------------
Toast {
    background: $background-cp;
    border: round $border;
    padding: 1 1;
    margin: 0;
}

Rule {
    margin: 0;
    color: $foreground;
}

Footer {
    &:ansi {
        background: ansi_black;
    }
    & .footer-key--key {
        color: $accent;
        background: transparent;
    }
    & .footer-key--description {
        background: transparent;
    }
}

HelpPanel {
    dock: right;
    split: none;
    position: absolute;
    width: 33%;
    min-width: 30;
    max-width: 60;
    border-left: vkey $foreground 30%;
    height: 100%;
    padding: 0 0;
    padding-right: 0;
    * {
        scrollbar-size-vertical: 1;
    }

    &:ansi {
        background: ansi_default;
        border-left: vkey ansi_black;

        Markdown, KeyPanel {
            background: ansi_default;
        }
    }

    #title {
        width: 1fr;
        text-align: center;
        text-style: bold;
        dock: top;
        display: none;
    }

    #widget-help {
        height: auto;
        max-height: 50%;
        width: 1fr;
        margin: 0;
        padding: 0 0;
        padding-top: 1;
        margin-top: 0;
        display: none;
        background: $surface;

        &:ansi {
            background: $surface;
        }

        MarkdownBlock {
            text-align: left;
            padding-left: 1;
            padding-right: 1;
        }
    }

    &.-show-help #widget-help {
        display: block;
    }

    KeyPanel#keys-help {
        width: 1fr;
        height: 1fr;
        min-width: initial;
        split: initial;
        border-left: none;
        padding: 0;
        scrollbar-size-vertical: 1;
        scrollbar-background: $background;
        scrollbar-color: $surface;
        scrollbar-color-active: $foreground;
        scrollbar-color-hover: $panel;
    }
}
BindingsTable > .bindings-table--divider {
    color: transparent;
}
BindingsTable > .bindings-table--header {
    text-style: dim italic;
    color: $accent;
}




# ---------------------------------------------
# COMMMAND LINE
# ---------------------------------------------
CommandLine {
    align: left bottom;

    & > Horizontal {
        width: 100%;
        align: center middle;
        height: 1;
        background: $background;
    &:ansi {
        background: ansi_black;
    }
    }

    & > Horizontal > Label {
        margin: 0 1;
    }
}
CommandLineInput {
    border: none;
    padding: 0 0;
    background: transparent;
    height: 1;
}
AutoComplete {
}
AutoCompleteList {
    background: $background;
    padding: 0 0;
    margin: 0;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
    max-height: 12;

    &:focus {
        border: none;
        padding: 0;
        margin: 0;
    }
    & > .option-list--option-highlighted, & > .option-list--option-hover-highlighted {
        background: $surface;
        text-style: bold;
    }
}

# ---------------------------------------------
# LOADING INDICATOR
# ---------------------------------------------

LoadingIndicator {
    background: $background;
    color: $foreground;
}

# ---------------------------------------------
# DATATABLE
# ---------------------------------------------
CollectionTable {
    background: $background-cp;
    scrollbar-size: 0 1;

    &:focus {
    }
}
.datatable--cursor {
    text-style: bold;
    color: $foreground;
    background: $surface;
}
.datatable--header {
    background: $background;
}
.datatable--fixed {
    background: $background;
    color: $primary;
}
.datatable--fixed-cursor {
    background: $surface;
    color: $primary;
}
.datatable--header-cursor {
    background: $surface;
    color: $primary;
}
.datatable--header-hover {
    background: $surface;
    color: $primary;
}

#table-container {
    margin-top: 0;
    border-top: solid $border;
    color: $foreground;

    &.placeholder {
        align: center middle;
        border-top: none;
        Static {
            width: auto;
            margin-top: 1;
        }
        .logo {
            color: $primary;
        }
    }

}
#header {
    height: auto;

    OpenCollectionsTabs {
        align: right bottom;
        height: 2;
        Tab {
            max-width: 14;
            max-height: 1;
        }
    }

}
#collection-header {
    padding: 0 1;
    margin: 0;
    .--uid {
        color: $primary;
        text-style: bold;
    }
    .--path {
        color: $secondary;
        text-style: bold;
    }
    .--remote {
        color: $accent;
        text-style: italic;
    }
}

# ---------------------------------------------
# HDF VIEWER
# ---------------------------------------------
HDFViewer {
    background: $background;
    color: $foreground;

    & > Vertical {
        layout: grid;
        grid-rows: 70% 30%;
    }

    & Header {
        padding: 0 1;
        margin: 0;
        height: auto;
        width: auto;

        & > .--uid {
            color: $primary;
            text-style: bold;
        }
        & > .--path {
            color: $secondary;
            text-style: bold;
        }
    }

    & AttrsView {
        padding: 0 1;
        background: $background;
        border: round $border;
        border-title-color: $border;

        &:focus-within {
            border: round $foreground;
            border-title-color: $foreground;
        }
        & > .--key {
            color: $primary;
        }
        & > .--value {
            color: $foreground;
        }
    }
    #nav-container {
        border: round $border;

        &:focus-within {
            border: round $foreground;
        }

        NavigationStatic {
            scrollbar-size-vertical: 0;

            & > .--cursor {
                text-style: reverse bold;
                background: $surface;
            }
            & > .--group {
                color: $primary;
            }
            & > .--dataset {
                color: $accent;
            }
            & > .--hovered {
                background: $surface;
            }
        }

        #nav-center {
            width: 2fr;
            border-right: vkey $border 50%;
            margin-left: 1;
        }
        #nav-static {
            display: none;
            width: 1fr;
            border-right: vkey $border 50%;
            margin-left: 1;
        }
        #nav-preview {
            width: 3fr;
            padding: 0 1;

            & > .--object {
                color: $secondary;
            }
            & > .--content {
                color: $foreground 80%;
            }
            & > .--group {
                color: $primary;
            }
            & > .--dataset {
                color: $accent;
            }
        }
    }


}

# ---------------------------------------------
# COMMAND PALETTE
# ---------------------------------------------
CommandPalette {
  background: transparent;
  & > .command-palette--highlight {
    background: $foreground;
    color: $surface;
    text-style: bold;
  }

  &>Vertical {
    margin-top: 0;
    height: 100%;
    width: 60%;
    min-width: 80;
    background: transparent;

    &:dark {
      background: transparent;
    }
  }

  &>.command-palette--help-text {
    color: $foreground;
    background: transparent;
    text-style: not bold italic dim;
  }

  & #--input {
    height: 3;
    padding: 0 0;
    margin: 0;
    visibility: visible;
    border: round $border;
    border-title-align: center;
    background: $background-cp;

    &.--list-visible {
      border-bottom: none;
    }

    SearchIcon {
      margin: 0 1;
    }

    CommandInput {
      margin: 0;
      border: none;
      background: $background-cp;
    }
  }

  & #--results {
    overlay: screen;
  }

  & LoadingIndicator {
    height: auto;
    visibility: hidden;
    border-bottom: hkey $border;
  }

  & LoadingIndicator.--visible {
    visibility: visible;
  }
}


CommandList {
  visibility: hidden;
  height: auto;
  max-height: 70vh;
  background: $background-cp;
  padding: 0 1;
  border: round $border;
  border-top: none;

  &.--visible {
    visibility: visible;
  }

  &:focus {
    border: blank;
  }

  &>.option-list--option-highlighted {
    color: $block-cursor-blurred-foreground;
    background: $surface;
    text-style: $block-cursor-blurred-text-style;
  }

  &>.option-list--option {
    padding: 0 2;
    color: $foreground;
    text-style: bold;
  }

  &:nocolor>.option-list--option-highlighted {
    text-style: reverse;
  }

}

# -------------------------
# PICKER
# -------------------------
CollectionPalette, RemoteCollectionPalette {
    & > .collection-list--uid {
        color: $foreground;
    }
    & > .collection-list--path {
        color: $foreground;
        text-style: not bold;
    }
    & > .collection-list--count {
        color: $foreground;
    }
}
RemotePalette {
    & > .remote-list--url {
        color: $foreground;
    }
    & > .remote-list--workspace {
        color: $foreground;
        text-style: not bold;
    }
}
KeybindPalette {
    border-title-align: left;
    border-title-color: $foreground;
}

# -------------------------
# MODAL PROMPT
# -------------------------
ModalPrompt {
    align: center middle;
}
#modal-prompt {
    height: auto;
    width: 50%;
    align: center middle;
    border: round $error;
    color: $error;

    Label {
        column-span: 2;
        width: 100%;
        content-align: center middle;
    }
    Horizontal {
        height: auto;
        align: center middle;
    }
    Button {
        background: $background;
        color: $foreground;
        border: round $surface;
        margin: 1 3;
        margin-bottom: 0;
    }
    Button:focus {
        color: $error;
        border: round $error;
        background: $background;
    }
}

# -------------------------
# CELL TOOLBOX
# -------------------------

CellContentScreen {
    align: center middle;
    background: transparent;

    #cell-content-container {
        width: 60%;
        min-width: 80;
        height: 70%;
        border: round $border;
        background: $background-cp;
        padding: 0;
    }

    #cell-content-label {
        width: 100%;
        height: 1;
        content-align: left middle;
        text-style: bold;
        background: transparent;
        color: $text-muted;
    }

    #cell-content-text-container {
        width: 100%;
        height: 1fr;
        padding: 0 1;
    }

    #cell-content-text {
        width: 100%;
        height: auto;
    }
}

